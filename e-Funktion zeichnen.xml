    <questiontext format="plain_text">
      <text><![CDATA[<p style="display: visible;">Die allgemeine Form einer Exponentialfunktion lautet \(f(x) = \) {@f(x)@}<br>Die Parameter a,b,h und k beeinflussen den Graphen der Exponentialfunktion auf unterschiedliche Weise.</p>
<p style="display: visible;">Gegeben ist die Funktion \(j(x) = \) {@j(x)@}</p>
<p style="display: visible;">a) Zeichne die Graphen dieser Funktionen in ein Koordinatensystem.</p>
<p style="display: visible;"><em>Du kannst dazu beide Eingabemöglichkeiten nutzen (Eingabefelder &amp; Slider)</em></p>
<p style="display: visible;">\(a = \) [[input:ans1]] [[validation:ans1]]</p>
<p style="display: visible;">\(b = \) [[input:ans2]] [[validation:ans2]]</p>
<p style="display: visible;">\(h = \) [[input:ans3]] [[validation:ans3]]</p>
<p style="display: visible;">\(k = \) [[input:ans4]] [[validation:ans4]]</p>
<p>[[jsxgraph width = "360px" height = "360px" input-ref-ans1 = "inputans1" input-ref-ans2 = "inputans2" input-ref-ans3 = "inputans3" input-ref-ans4 = "inputans4"]] JXG.Options.axis.ticks.minorTicks = 0; var board = JXG.JSXGraph.initBoard(divid, { boundingbox: [-10, 10, 10, -10], axis: true, grid: true, showNavigation: true, showCopyright: false }); var a = board.create('slider', [[-9,8], [-5,8], [-4, 0.5, 4]], { name: 'a = ', visible: true, snapWidth: 0.5, point1: {fixed: false}, point2: {fixed: false}, baseline: {fixed: false, needsRegularUpdate: true} }); var b = board.create('slider', [[-9,6], [-5,6], [-4, 0.5, 4]], { name: 'b = ', visible: true, snapWidth: 0.5, point1: {fixed: false}, point2: {fixed: false}, baseline: {fixed: false, needsRegularUpdate: true} }); var h = board.create('slider', [[-9,4], [-5,4], [-4, 0.5, 4]], { name: 'h = ', visible: true, snapWidth: 0.5, point1: {fixed: false}, point2: {fixed: false}, baseline: {fixed: false, needsRegularUpdate: true} }); var k = board.create('slider', [[-9,2], [-5,2], [-4, 0.5, 4]], { name: 'k = ', visible: true, snapWidth: 0.5, point1: {fixed: false}, point2: {fixed: false}, baseline: {fixed: false, needsRegularUpdate: true} }); stack_jxg.bind_slider(inputans1, a); stack_jxg.bind_slider(inputans2, b); stack_jxg.bind_slider(inputans3, h); stack_jxg.bind_slider(inputans4, k); var f = function(x) {return a.Value()*Math.E**(b.Value()*(x-h.Value()))+k.Value(); }; var graph = board.create('functiongraph', [f]); [[/jsxgraph]]</p>]]></text>
