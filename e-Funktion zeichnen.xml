    <questionvariables>
      <text><![CDATA[/*Funktion konvertiert Zahlen der Form 1.0, 2.0, 3.0 usw. zu 1, 2, 3*/
konvertZahl(z):=block(
    [newZ:0],
    /*Wenn */
    if floatnump(z) and floor(10 * (z - floor(z)))=0 then(
        newZ:fix(z)
        )
    else(
    newZ:z),
return (newZ)
);


f(x):=a*%e^(b*(x-h))+k;

faktor_list:delete(0, makelist(-4 + i/2, i, 0, 16)); /*Liste von -4 -> +4 */
a_faktor:float(rand(faktor_list));
a_faktor:konvertZahl(a_faktor);

b_faktor:float(rand(faktor_list));
b_faktor:konvertZahl(b_faktor);

h_faktor:float(rand(faktor_list));
h_faktor:konvertZahl(h_faktor);

k_faktor:float(rand(faktor_list));
k_faktor:konvertZahl(k_faktor);

j(x):=a_faktor*%e^(b_faktor*(x+h_faktor))+k_faktor;]]></text>
